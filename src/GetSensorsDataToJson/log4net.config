<log4net>
	<appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
		<param name="File" value="Logs\\log\\log.log"/>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
		<appendToFile value="true"/>
		<rollingStyle value="Size"/>
		<maxSizeRollBackups value="10"/>
		<maximumFileSize value="5MB"/>
		<staticLogFileName value="true"/>
		<layout type="log4net.Layout.PatternLayout">
			<!-- param name="Header" value="[Header]%newline" / -->
			<!-- param name="Footer" value="[Footer]%newline" / -->
			<!-- conversionPattern value="[%date] |%-5.5thread| %-5level | %-10.10logger |... %10.10class::%-20.30method | %message%exception%newline" / -->
			<conversionPattern value="[%date] | %-5level | %message%exception%newline"/>
		</layout>
	</appender>

	<appender name="SensorsDataAppender" type="log4net.Appender.RollingFileAppender">
		<param name="File" value="Logs\\SensorsData\\SensorsData.log"/>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
		<appendToFile value="true"/>
		<rollingStyle value="Size"/>
		<maxSizeRollBackups value="10"/>
		<maximumFileSize value="5MB"/>
		<staticLogFileName value="true"/>
		<layout type="log4net.Layout.PatternLayout">
			<!-- param name="Header" value="[Header]%newline" / -->
			<!-- param name="Footer" value="[Footer]%newline" / -->
			<!-- conversionPattern value="[%date] |%-5.5thread| %-5level | %-10.10logger |... %10.10class::%-20.30method | %message%exception%newline" / -->
			<conversionPattern value="[%date] | %message%exception%newline"/>
		</layout>
	</appender>

	<root>
		<level value="ALL" />
	</root>

	<logger name="LogFileLogger" additivity="false" >
		<level value="ALL" />
		<appender-ref ref="LogFileAppender"/>
	</logger>

	<logger name="SensorsDataLogger" additivity="false" >
		<level value="ALL" />
		<appender-ref ref="SensorsDataAppender"/>
	</logger>
</log4net>
